{
  "name": "private-streams",
  "private": true,
  "scripts": {
    "dev:prediction-market": "pnpm --filter prediction-market-frontend dev",
    "build:prediction-market": "pnpm --filter prediction-market-frontend build",
    "dev:insider-streams": "pnpm --filter insider-streams-frontend dev",
    "build:insider-streams": "pnpm --filter insider-streams-frontend build",
    "build:contracts": "cd contracts && forge build --via-ir --skip SetupAll DeployPolicyEngine",
    "test:contracts": "cd contracts && forge test --via-ir --skip SetupAll DeployPolicyEngine",
    "e2e": "pnpm --filter @private-streams/scripts e2e",
    "wagmi": "pnpm --filter @private-streams/common wagmi"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
