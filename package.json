{
  "name": "private-streams",
  "private": true,
  "scripts": {
    "postinstall": "npx next telemetry disable || true; npx turbo telemetry disable || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "codegen": "turbo run codegen",
    "codegen:insider-streams": "turbo run codegen --filter=insider-streams-frontend",
    "wagmi": "turbo run wagmi",
    "e2e": "turbo run e2e",
    "dev:insider-streams": "turbo run dev --filter=insider-streams-frontend",
    "build:insider-streams": "turbo run build --filter=insider-streams-frontend"
  },
  "devDependencies": {
    "turbo": "^2.8.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "patchedDependencies": {
      "@johanneskares/wallet-mock@1.4.1": "patches/@johanneskares__wallet-mock@1.4.1.patch"
    }
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
