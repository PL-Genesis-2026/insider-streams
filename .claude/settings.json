      "Bash(echo $PATH)",
      "Bash(bun:*)",
      "Bash(cast:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(cre:*)",
      "Bash(curl:*)",
      "Bash(export:*)",
      "Bash(forge:*)",
      "Bash(gcloud:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(test:*)",
      "Bash(cast call 0xED53f1AE2Ee56ca0fDAA79f0e050E873FCF86616 \"getAuction\\(uint256\\)\\(\\(address,uint256,uint256,uint256,address,uint256,uint8\\)\\)\" 0 --rpc-url https://ethereum-sepolia-rpc.publicnode.com)",
      "Bash(cast call 0xED53f1AE2Ee56ca0fDAA79f0e050E873FCF86616 \"getForwarderAddress\\(\\)\\(address\\)\" --rpc-url https://ethereum-sepolia-rpc.publicnode.com)"
    ]
