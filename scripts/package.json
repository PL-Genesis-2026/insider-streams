{
  "name": "@private-streams/scripts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "e2e": "tsx e2e_tests/secret-marketplace-e2e.ts",
    "e2e:secret-marketplace": "tsx e2e_tests/secret-marketplace-e2e.ts",
    "e2e:user-balance-recording-fallback": "tsx e2e_tests/user-balance-recording-fallback-e2e.ts",
    "e2e:secret-marketplace-auction-closer": "tsx e2e_tests/secret-marketplace-auction-closer-e2e.ts",
    "e2e:external-prediction-market-settler": "tsx e2e_tests/simple-market-e2e.ts",
    "e2e:bid-workflow": "tsx --env-file=.env e2e_tests/bid-workflow-e2e.ts",
    "e2e:frontend-api": "tsx frontend-api-e2e.ts",
    "e2e:external-marketplace-settlement-resolved-handler": "tsx e2e_tests/external-marketplace-settlement-resolved-handler-e2e.ts",
    "e2e:auction-cancelled-handler": "tsx e2e_tests/auction-cancelled-handler-e2e.ts",
    "e2e:private-token-api": "tsx private-token-api-e2e.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "frontend-api": "tsx frontend-api.ts",
    "private-token-api": "tsx private-token-api.ts",
    "create-events": "tsx --env-file=.env create-events.ts",
    "spawn-auctions": "tsx --env-file=.env spawn-auctions.ts",
    "request-settlements": "tsx --env-file=.env request-settlements.ts",
    "place-bids": "tsx --env-file=.env place-bids.ts",
    "run-demo": "bash run-demo.sh"
