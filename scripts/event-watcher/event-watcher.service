[Unit]
Description=Private Streams Event Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bawler
WorkingDirectory=/home/bawler/insider-streams/scripts
ExecStart=/bin/bash -c 'source ~/.nvm/nvm.sh && npx tsx event-watcher/index.ts'
Restart=always
RestartSec=10
EnvironmentFile=/home/bawler/insider-streams/scripts/.env
Environment=PATH=/home/bawler/.cre/bin:/home/bawler/.foundry/bin:/home/bawler/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
StandardOutput=append:/home/bawler/insider-streams/logs/event-watcher.log
StandardError=append:/home/bawler/insider-streams/logs/event-watcher.log

[Install]
WantedBy=multi-user.target
